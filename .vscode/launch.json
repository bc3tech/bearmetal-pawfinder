{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Flutter: Debug (Current Device)",
			"type": "dart",
			"request": "launch",
			"program": "lib/main.dart",
			"cwd": "${workspaceFolder}",
			"preLaunchTask": "Flutter: Get Dependencies",
			"toolArgs": [
				"--define=dart.vm.product=false"
			],
			"console": "debug",
			"flutterMode": "debug"
		},
		{
			"name": "Flutter: Debug Web",
			"type": "dart",
			"request": "launch",
			"program": "lib/main.dart",
			"cwd": "${workspaceFolder}",
			"deviceId": "chrome",
			"flutterMode": "debug",
			"preLaunchTask": "Flutter: Get Dependencies"
		},
		{
			"name": "Flutter: Profile Mode",
			"type": "dart",
			"request": "launch",
			"program": "lib/main.dart",
			"cwd": "${workspaceFolder}",
			"flutterMode": "profile",
			"preLaunchTask": "Flutter: Get Dependencies"
		},
		{
			"name": "Flutter: Release Mode",
			"type": "dart",
			"request": "launch",
			"program": "lib/main.dart",
			"cwd": "${workspaceFolder}",
			"flutterMode": "release",
			"preLaunchTask": "Flutter: Get Dependencies"
		},
		{
			"name": "Dart: Run Tests",
			"type": "dart",
			"request": "launch",
			"program": "test/",
			"cwd": "${workspaceFolder}",
			"args": [
				"--verbose"
			],
			"console": "debug"
		}
	]
}