# Flutter DevContainer Environment Variables
# Customize these as needed

# Flutter channel (stable, beta, dev)
FLUTTER_CHANNEL=stable

# Java home for Android builds
JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64

# Android SDK settings
ANDROID_HOME=/root/android-sdk-linux
ANDROID_SDK_ROOT=/root/android-sdk-linux

# Gradle settings
GRADLE_USER_HOME=/root/.gradle

# Dart settings
PUB_CACHE=/root/.pub-cache

# Development settings
FLUTTER_NO_ANALYTICS=false
PUB_ENVIRONMENT=vscode
